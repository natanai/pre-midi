{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pre-midi",
  "version": "../package.json",
  "identifier": "app.premidi.studio",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run desktop:prepare",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pre-midi",
        "width": 1440,
        "height": 940,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost 'self'; img-src 'self' blob: data:; media-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "15.4"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
