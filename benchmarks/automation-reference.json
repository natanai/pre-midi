  "policy": {
    "version": 1,
    "method": {
      "pcm": "Float32 before WAV quantization; signal peak is sample peak, not reconstructed true peak",
      "spectrum": "16384-point four-term Blackman-Harris FFT; sum power within +/-5 bins of each expected in-band harmonic; residual excludes bins 0..5",
      "offHarmonicDb": "10 log10(residual / harmonic energy). Alias proxy only for stationary periodic fixtures without modulation or noise; not a universal alias meter. Aliases landing inside harmonic masks are unobservable.",
      "tuning": "Interpolated rising zero crossings on a steady sine; cents = 1200 log2(measured/expected)",
      "envelope": "Constant unity input through actual scheduled gain vs independently evaluated piecewise linear reference at every sample",
      "clicks": "Maximum step in envelope error residual; zero-decay sustain step is intentional legacy behavior",
      "cost": "Offline wall milliseconds including context setup; median of 5 measured runs after warm-up; informational only, no real-time CPU claim",
      "repeatability": "Maximum and RMS PCM difference between equivalent independently constructed offline graphs in the same browser process"
    },
    "gates": {
      "envelopeMaxError": 0.00003,
      "envelopeResidualStep": 0.00003,
      "tuningCents": 0.3,
      "sineOffHarmonicDb": -65,
      "steadyDc": 0.002,
      "determinismMaxError": 1e-7,
      "releasedRms": 0.000002,
      "stereoLeakRms": 1e-7,
      "overlapMaxError": 2e-7,
      "driveMinimumImprovementDb": 6,
      "driveRouteOffHarmonicDb": -25
    },
    "deferred": [
      {
        "metric": "bright oscillator absolute alias floor",
        "reason": "record baseline first; harmonic residual has masking blind spots and browser band-limiting differs"
      },
      {
        "metric": "drive absolute alias floor",
        "reason": "relative 4x-vs-none gate applies to specified high sine fixture only; compare native reconstruction filters when SYN-007 exists"
      },
      {
        "metric": "CPU ceiling",
        "reason": "virtualized offline timings cannot establish desktop/mobile callback deadlines or underruns"
      },
      {
        "metric": "native parity",
        "reason": "no native DSP backend yet"
      },
      {
        "metric": "live device acoustic parity",
        "reason": "live/offline share scheduler; hardware loopback capture is still required"
      }
    ],
    "references": [
      {
