{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://natanai.github.io/pre-midi/contracts/synth-voice",
  "title": "Host-neutral pre-midi synth voice execution plans",
  "description": "Current host-neutral synth plans carry authored patches and resolved modulation, automation and post-processing recipes. Project-file validation remains in the canonical schema.",
  "type": "object",
  "required": [
    "contract",
    "version",
    "presetId",
    "patch",
    "start",
    "duration",
    "off",
    "end",
    "graphEnd",
    "audibleEnd",
    "peak",
    "amplitude",
    "filter",
    "movement",
    "oscillators",
    "routing",
    "expression",
    "postProcessing"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "pre-midi-synth-voice"
    },
    "version": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "presetId": {
      "type": "string"
    },
    "patch": {
      "type": "object"
    },
    "start": {
      "type": "number",
      "minimum": 0
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "off": {
      "type": "number",
      "minimum": 0
    },
    "end": {
      "type": "number",
      "minimum": 0
    },
    "graphEnd": {
      "type": "number",
      "minimum": 0
    },
    "audibleEnd": {
      "type": "number",
      "minimum": 0
    },
    "peak": {
      "type": "number",
      "minimum": 0
    },
    "amplitude": {
      "$ref": "dsp-contract.schema.json"
    },
    "filter": {
      "type": "object"
    },
    "movement": {
      "type": "object"
    },
    "oscillators": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "wave",
          "level",
          "octave",
          "detune",
          "frequency",
          "pitch"
        ]
      }
    },
    "routing": {
      "const": [
        "oscillators_and_noise",
        "filter",
        "drive",
        "amplitude",
        "tremolo",
        "pan",
        "post_processing",
        "dry_and_effect_sends"
      ]
    },
    "expression": {
      "type": "object"
    },
    "modulation": {
      "type": "object",
      "required": [
        "version",
        "routes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "routes": {
          "type": "array",
          "maxItems": 16
        }
      }
    },
    "automation": {
      "type": "object",
      "description": "v3 compiled filter.cutoff timeline; validated by src/dsp/automation.js"
    },
    "postProcessing": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "mix"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "compressor",
              "gate",
              "limiter",
              "deesser",
              "chorus",
              "flanger",
              "phaser",
              "autopan",
              "ringmod",
              "frequencyshift"
            ]
          },
          "mix": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "description": "Resolved recipes from src/dsp/post-processing.js; authored rate/sync remain in patch.chain.instances."
      }
    },
    "parameterAutomation": {
      "type": "array",
      "maxItems": 8,
      "description": "Compiled current parameter lanes from src/dsp/automation.js"
    }
  },
  "x-parameter-registry": "src/dsp/parameters.js: SYNTH_PARAMETERS",
  "x-patch-validation": "synth.js: validatePatch, before creating execution plans",
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "enum": [
              2,
              3
            ]
          }
        }
      },
      "then": {
        "required": [
          "modulation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "modulation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 3
          }
        }
      },
      "then": {
        "required": [
          "automation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "automation"
          ]
        }
      }
    }
  ],
  "x-phase-contract": "v2/v3 phase is relative to exact authored note-on, including fractional-sample initial interval; browser host corrections cannot redefine native semantics"
}
